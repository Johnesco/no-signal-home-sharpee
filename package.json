{
  "name": "no-signal-home",
  "version": "1.0.0",
  "description": "A sci-fi salvage horror text adventure on a derelict corporate freighter.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "build:browser": "npx sharpee build-browser",
